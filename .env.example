# Flask 应用配置
# 复制此文件为 .env 并填写实际值

# 应用端口（生产环境由部署平台自动设置）
PORT=5000

# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=0

# 应用密钥（生产环境请使用强随机密钥）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# 可选：API 限流配置
# RATE_LIMIT_DEFAULT=100/hour

# 可选：日志级别
# LOG_LEVEL=INFO

# 可选：最大请求大小（字节）
# MAX_CONTENT_LENGTH=16777216
